{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "linkgarden",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-19",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [
		{
			"pattern": "linkgarden.moamenhredeen.me",
			"custom_domain": true
		}
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"vars": {
		"EMAIL_FROM": "hello@linkgarden.moamenhredeen.me"
	},
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["hello@linkgarden.moamenhredeen.me"]
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dont-loose-it-db",
			"database_id": "b55b0462-0cf9-4bdd-83b1-058a687c678b",
			"migrations_dir": "drizzle"
		}
	]
}
